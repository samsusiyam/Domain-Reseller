APP_NAME="DomainReseller"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MySQL 8.0+ / MariaDB 10.5+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=domain_reseller
DB_USERNAME=root
DB_PASSWORD=

# Shared Hosting Compatible: file cache and database queue
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=dr_cache_

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Multi-Currency Configuration (Primary: USD, Secondary: BDT)
DEFAULT_CURRENCY=USD
CURRENCY_EXCHANGE_API_KEY=
USD_TO_BDT_RATE=120.0000

# Reseller Platform Security & Limits
RESELLER_API_DEFAULT_RATE_LIMIT=60
RESELLER_MIN_WALLET_DEPOSIT=10.00
CLIENT_MIN_WALLET_DEPOSIT=5.00

# Registrars API Credentials
# Namecheap
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true

# Spaceship
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
SPACESHIP_SANDBOX=true

# Dynadot
DYNADOT_API_KEY=
DYNADOT_SANDBOX=true

# AtakDomain
ATAKDOMAIN_API_KEY=
ATAKDOMAIN_API_SECRET=
ATAKDOMAIN_SANDBOX=true

# NameSilo
NAMESILO_API_KEY=
NAMESILO_SANDBOX=true

# Payment Gateways Credentials
# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# bKash Tokenized API
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# Binance Pay (Personal / Merchant API)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MERCHANT_ID=
BINANCE_SANDBOX=true
